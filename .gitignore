# Virtual Environments
venv/
env/
.env

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebooks
.ipynb_checkpoints

# Large Datasets & Machine Learning Artifacts
datasets/raw/
datasets/processed/
datasets/features/
# We keep the raw CICIDS2017 and cleaned dataset ignored because they are > 100MB
datasets/CICIDS2017/
datasets/cleaned_cicids2017/
# But we DO push the realtime feature arrays since they are < 100MB
!datasets/realtime_features/
!datasets/realtime_features/**/*
# Keep csv ignored globally, except in certain directories if needed
*.csv
# Un-ignore npy so realtime features can be pushed
# *.npy

# Trained Models (Pushing them as requested)
!models/**/*.pkl
!models/**/*.keras
!models/**/*.txt

# Databases
backend/data/*.db
backend/data/*.sqlite
*.db
*.sqlite

# IDEs and OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local reproducibility symlinks
experiments
results

